{
  "scopeName": "source.fusionlocks",
  "patterns": [
    {
      "name": "comment.line.number-sign.fusionlocks",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.fusionlocks",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.fusionlocks",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.single.fusionlocks",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.fusionlocks",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.fusionlocks",
      "match": "\\b(let|set|print|if|else|while)\\b"
    },
    {
      "name": "constant.language.boolean.fusionlocks",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "keyword.operator.logical.fusionlocks",
      "match": "\\b(and|or|not)\\b"
    },
    {
      "name": "constant.numeric.fusionlocks",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "keyword.operator.fusionlocks",
      "match": "==|!=|<=|>=|[+*/%<>=-]"
    }
  ]
}
